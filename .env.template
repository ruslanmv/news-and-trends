########################################
# TechStatic Insights – .env.template
########################################
# Copy this file to `.env` and fill in the values you need.
# Only a subset is required depending on which LLM provider you use.
########################################

############################
# Core LLM configuration
############################

# Preferred way to choose the LLM model for CrewAI.
# Examples:
#   NEWS_LLM_MODEL="ollama/gemma:2b"                     # local Ollama (default)
#   NEWS_LLM_MODEL="openai/gpt-4o-mini"                  # OpenAI
#   NEWS_LLM_MODEL="anthropic/claude-3-5-sonnet-latest"  # Anthropic
#   NEWS_LLM_MODEL="watsonx/meta-llama/llama-3-1-70b-instruct"  # IBM watsonx.ai
NEWS_LLM_MODEL=ollama/gemma:2b

# Optional fallback model name (only used if NEWS_LLM_MODEL is unset).
LLM_MODEL=

# Optional: sampling temperature for all LLM calls.
# Defaults to 0.7 if not set.
NEWS_LLM_TEMPERATURE=0.7


############################
# Local LLM – Ollama
############################

# Base URL for your local Ollama server.
# This is what the project uses by default for "ollama/..." models.
# Typical local setup:
#   ollama serve
#   ollama pull gemma:2b
OLLAMA_API_BASE=http://127.0.0.1:11434

# Alternative variable also checked by the code; you can leave it blank
# if you’re already setting OLLAMA_API_BASE.
OLLAMA_HOST=


############################
# OpenAI (optional)
############################

# Required if you use an OpenAI model, e.g. NEWS_LLM_MODEL="openai/gpt-4o-mini"
OPENAI_API_KEY=

# Optional: custom base URL or organization (only needed for special setups).
OPENAI_BASE_URL=
OPENAI_ORG_ID=


############################
# Anthropic Claude (optional)
############################

# Required if you use an Anthropic model, e.g. NEWS_LLM_MODEL="anthropic/claude-3-5-sonnet-latest"
ANTHROPIC_API_KEY=


############################
# IBM watsonx.ai (optional)
############################

# Watsonx API base URL (example region below).
# Use the URL for your region if different.
WATSONX_URL=https://us-south.ml.cloud.ibm.com

# API key for Watsonx.
WATSONX_APIKEY=

# Project ID for your Watsonx project.
WATSONX_PROJECT_ID=


########################################
# Notes
########################################
# - For local development with Ollama only, you usually just need:
#     OLLAMA_API_BASE
#     NEWS_LLM_MODEL=ollama/gemma:2b
#
# - For cloud providers, set the respective API key and a NEWS_LLM_MODEL
#   that matches the provider (OpenAI / Anthropic / Watsonx).
