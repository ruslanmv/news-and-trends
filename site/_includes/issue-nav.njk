{# site/_includes/issue-nav.njk — prev / next within the same collection #}
{% set issues = collections.issue | reverse %}
{% set currentIndex = -1 %}

{% for item in issues %}
  {% if item.url == page.url %}
    {% set currentIndex = loop.index0 %}
  {% endif %}
{% endfor %}

{% if currentIndex != -1 %}
  {% set prev = issues[currentIndex + 1] %}
  {% set next = issues[currentIndex - 1] %}

  <nav class="nt-issue-nav" aria-label="Issue navigation">
    {% if prev %}
      <a class="prev" href="{{ prev.url | url }}">
        <i class="fas fa-arrow-left"></i> {{ prev.date | readableDate }}
      </a>
    {% else %}<span></span>{% endif %}
    {% if next %}
      <a class="next" href="{{ next.url | url }}">
        {{ next.date | readableDate }} <i class="fas fa-arrow-right"></i>
      </a>
    {% endif %}
  </nav>
{% endif %}
