<!DOCTYPE html>
<html lang="en">
<head>
  <base target="_self">
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ title }} | {{ site.title }}</title>
  <meta name="description" content="{{ site.description }}">
  <meta name="robots" content="index,follow">

  <!-- Open Graph -->
  <meta property="og:title" content="{{ title }} | {{ site.title }}">
  <meta property="og:description" content="{{ site.description }}">
  <meta property="og:type" content="website">
  <meta property="og:url" content="{{ site.url }}">

  <!-- Fonts -->
  <link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@400;500;700;900&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.3/css/all.min.css">

  <style>
    :root {
      --mm-bg: #f5f5f5;
      --mm-surface: #ffffff;
      --mm-border: #e8e8e8;
      --mm-text: #111111;
      --mm-text-muted: #6c757d;
      --mm-accent: #2a7ae2;
      --mm-accent-dark: #205caa;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      font-family: 'Inter', system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
      background: linear-gradient(180deg, #f5f5f5 0%, #ffffff 40%, #f5f5f5 100%);
      color: var(--mm-text);
      line-height: 1.6;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
    }

    h1, h2, h3, h4, h5, h6 {
      font-family: 'Orbitron', system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
      color: var(--mm-text);
    }

    a {
      color: var(--mm-accent);
      text-decoration: none;
      transition: color 0.3s ease;
    }

    a:hover {
      color: var(--mm-accent-dark);
    }

    /* Breaking News Ticker */
    .news-ticker {
      background: linear-gradient(90deg, transparent, rgba(42, 122, 226, 0.15), transparent);
      color: var(--mm-accent);
      padding: 0.5rem 0;
      overflow: hidden;
      border-bottom: 1px solid var(--mm-border);
    }

    .ticker-content {
      display: flex;
      white-space: nowrap;
      animation: scroll-ticker 30s linear infinite;
    }

    .ticker-content span {
      margin: 0 2rem;
      font-weight: 600;
      font-size: 0.9rem;
    }

    @keyframes scroll-ticker {
      0% { transform: translateX(0); }
      100% { transform: translateX(-50%); }
    }

    /* Header */
    header {
      background: var(--mm-surface);
      border-bottom: 1px solid var(--mm-border);
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.03);
      position: sticky;
      top: 0;
      z-index: 50;
      backdrop-filter: blur(10px);
      background: rgba(255, 255, 255, 0.95);
    }

    .header-container {
      max-width: 1200px;
      margin: 0 auto;
      padding: 1rem 1.5rem;
    }

    .header-top {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 1rem;
    }

    .brand {
      display: flex;
      align-items: center;
      gap: 0.75rem;
    }

    .logo-circle {
      width: 48px;
      height: 48px;
      background: linear-gradient(135deg, var(--mm-accent), var(--mm-accent-dark));
      border-radius: 50%;
      animation: pulse-glow 2s ease-in-out infinite;
    }

    @keyframes pulse-glow {
      0%, 100% { opacity: 1; }
      50% { opacity: 0.7; }
    }

    .brand-text h1 {
      font-size: 1.5rem;
      font-weight: 900;
      background: linear-gradient(135deg, var(--mm-accent), var(--mm-accent-dark));
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
      margin: 0;
    }

    .brand-text p {
      font-size: 0.7rem;
      color: var(--mm-text-muted);
      text-transform: uppercase;
      letter-spacing: 0.1em;
      margin: 0;
    }

    /* Navigation */
    nav {
      display: flex;
      align-items: center;
      gap: 2rem;
      flex-wrap: wrap;
    }

    nav a {
      color: var(--mm-text);
      font-weight: 600;
      font-size: 0.95rem;
      transition: color 0.3s ease;
      position: relative;
    }

    nav a::after {
      content: '';
      position: absolute;
      bottom: -4px;
      left: 0;
      width: 0;
      height: 2px;
      background: var(--mm-accent);
      transition: width 0.3s ease;
    }

    nav a:hover::after {
      width: 100%;
    }

    .header-actions {
      display: flex;
      align-items: center;
      gap: 1rem;
    }

    .btn-primary {
      background: var(--mm-accent);
      color: white;
      padding: 0.5rem 1.5rem;
      border-radius: 999px;
      font-weight: 700;
      border: none;
      cursor: pointer;
      transition: all 0.3s ease;
      box-shadow: 0 4px 15px rgba(42, 122, 226, 0.3);
    }

    .btn-primary:hover {
      background: var(--mm-accent-dark);
      transform: translateY(-2px);
      box-shadow: 0 6px 20px rgba(42, 122, 226, 0.4);
    }

    /* Main Content */
    main {
      flex: 1;
      max-width: 1200px;
      width: 100%;
      margin: 2rem auto;
      padding: 0 1.5rem;
    }

    .content-card {
      background: var(--mm-surface);
      border-radius: 16px;
      padding: 2.5rem 2rem;
      border: 1px solid var(--mm-border);
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.03);
    }

    .content-card h1 {
      font-size: 2.5rem;
      margin-bottom: 1rem;
      color: var(--mm-text);
    }

    .content-card h2 {
      font-size: 1.8rem;
      margin-top: 2rem;
      margin-bottom: 1rem;
      color: var(--mm-text);
      border-bottom: 2px solid var(--mm-border);
      padding-bottom: 0.5rem;
    }

    .content-card h3 {
      font-size: 1.4rem;
      margin-top: 1.5rem;
      margin-bottom: 0.75rem;
      color: var(--mm-text);
    }

    .content-card p {
      margin-bottom: 1rem;
      color: var(--mm-text);
      line-height: 1.7;
    }

    .content-card ul,
    .content-card ol {
      margin-left: 1.5rem;
      margin-bottom: 1rem;
    }

    .content-card li {
      margin-bottom: 0.5rem;
    }

    .content-card code {
      font-family: 'Courier New', monospace;
      background: var(--mm-bg);
      padding: 0.2rem 0.4rem;
      border-radius: 4px;
      font-size: 0.9em;
      border: 1px solid var(--mm-border);
    }

    .content-card a {
      color: var(--mm-accent);
      font-weight: 500;
    }

    .content-card a:hover {
      color: var(--mm-accent-dark);
      text-decoration: underline;
    }

    /* Meta Information */
    .meta {
      display: flex;
      flex-wrap: wrap;
      gap: 0.75rem;
      margin-bottom: 2rem;
      font-size: 0.9rem;
    }

    .meta-pill {
      padding: 0.4rem 0.9rem;
      border-radius: 999px;
      background: var(--mm-bg);
      border: 1px solid var(--mm-border);
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
      color: var(--mm-text-muted);
    }

    .meta-pill .emoji {
      font-size: 1rem;
    }

    /* Category Badges */
    .category-badge {
      display: inline-block;
      font-size: 0.7rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      padding: 0.25rem 0.6rem;
      border-radius: 999px;
      vertical-align: middle;
    }

    .news-badge {
      background: rgba(42, 122, 226, 0.15);
      color: var(--mm-accent);
      border: 1px solid var(--mm-accent);
    }

    .trend-badge {
      background: rgba(168, 85, 247, 0.15);
      color: #a855f7;
      border: 1px solid #a855f7;
    }

    /* Archive List */
    .archive-list {
      list-style: none;
      margin-left: 0;
      margin-top: 1.5rem;
    }

    .archive-list li {
      margin-bottom: 1rem;
      padding: 1.25rem 1.5rem;
      background: var(--mm-surface);
      border-radius: 12px;
      border: 1px solid var(--mm-border);
      transition: all 0.3s ease;
    }

    .archive-list li:hover {
      transform: translateY(-2px);
      box-shadow: 0 10px 25px rgba(0, 0, 0, 0.05);
      border-color: var(--mm-accent);
    }

    /* Post Header */
    .post-header {
      margin-bottom: 2rem;
      padding-bottom: 1.5rem;
      border-bottom: 2px solid var(--mm-border);
    }

    .post-kicker {
      font-size: 0.85rem;
      text-transform: uppercase;
      letter-spacing: 0.15em;
      color: var(--mm-accent);
      margin-bottom: 0.5rem;
      font-weight: 700;
    }

    .post-title {
      font-size: 2rem;
      margin: 0 0 0.75rem;
      line-height: 1.3;
      color: var(--mm-text);
    }

    .post-meta-line {
      font-size: 0.9rem;
      color: var(--mm-text-muted);
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem;
      align-items: center;
    }

    .post-meta-line span + span::before {
      content: "• ";
      margin-right: 0.5rem;
    }

    /* Footer */
    footer {
      background: var(--mm-surface);
      border-top: 1px solid var(--mm-border);
      margin-top: 4rem;
    }

    .footer-container {
      max-width: 1200px;
      margin: 0 auto;
      padding: 3rem 1.5rem 2rem;
    }

    .footer-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
      gap: 2rem;
      margin-bottom: 2rem;
    }

    .footer-section h5 {
      font-size: 1rem;
      font-weight: 700;
      margin-bottom: 1rem;
      color: var(--mm-text);
    }

    .footer-section ul {
      list-style: none;
    }

    .footer-section ul li {
      margin-bottom: 0.5rem;
    }

    .footer-section a {
      color: var(--mm-text-muted);
      transition: color 0.3s ease;
    }

    .footer-section a:hover {
      color: var(--mm-accent);
    }

    .social-links {
      display: flex;
      gap: 1rem;
      margin-top: 1rem;
    }

    .social-links a {
      width: 40px;
      height: 40px;
      background: var(--mm-bg);
      border: 1px solid var(--mm-border);
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: all 0.3s ease;
    }

    .social-links a:hover {
      background: var(--mm-accent);
      color: white;
      border-color: var(--mm-accent);
    }

    .footer-bottom {
      border-top: 1px solid var(--mm-border);
      padding-top: 1.5rem;
      text-align: center;
      font-size: 0.85rem;
      color: var(--mm-text-muted);
    }

    /* Responsive */
    @media (max-width: 768px) {
      .header-top {
        flex-direction: column;
        align-items: flex-start;
        gap: 1rem;
      }

      nav {
        flex-direction: column;
        align-items: flex-start;
        gap: 0.75rem;
      }

      .content-card {
        padding: 1.5rem 1rem;
      }

      .content-card h1 {
        font-size: 1.8rem;
      }

      .content-card h2 {
        font-size: 1.4rem;
      }

      .footer-grid {
        grid-template-columns: 1fr;
      }
    }
  </style>
</head>
<body>
  <!-- Breaking News Ticker -->
  <div class="news-ticker">
    <div class="ticker-content">
      <span><i class="fas fa-bolt"></i> LIVE: AI & Tech News Updates</span>
      <span><i class="fas fa-chart-line"></i> Trending: Latest Technology Insights</span>
      <span><i class="fas fa-globe"></i> Global Coverage: 24/7 News Monitoring</span>
      <span><i class="fas fa-bolt"></i> LIVE: AI & Tech News Updates</span>
      <span><i class="fas fa-chart-line"></i> Trending: Latest Technology Insights</span>
      <span><i class="fas fa-globe"></i> Global Coverage: 24/7 News Monitoring</span>
    </div>
  </div>

  <!-- Header -->
  <header>
    <div class="header-container">
      <div class="header-top">
        <!-- Logo -->
        <div class="brand">
          <div class="logo-circle"></div>
          <div class="brand-text">
            <h1>{{ site.shortName }}</h1>
            <p>ENTERPRISE NEWS NETWORK</p>
          </div>
        </div>

        <!-- Action Buttons -->
        <div class="header-actions">
          <a href="https://ruslanmv.com" class="btn-primary">
            <i class="fas fa-home"></i> MAIN SITE
          </a>
        </div>
      </div>

      <!-- Navigation -->
      <nav>
        <a href="{{ '/' | url }}">HOME</a>
        <a href="{{ '/' | url }}">NEWS</a>
        <a href="{{ '/archive/' | url }}">ARCHIVE</a>
        <a href="https://ruslanmv.com">ABOUT</a>
        <a href="https://github.com/ruslanmv/news-and-trends">GITHUB</a>
      </nav>
    </div>
  </header>

  <!-- Main Content -->
  <main>
    <article class="content-card">
      {# Special header for news + trend posts #}
      {% if type == "news" or type == "trend" %}
        <header class="post-header">
          <p class="post-kicker">
            {% if type == "trend" %}
              <i class="fas fa-fire"></i> TREND ANALYSIS
            {% else %}
              <i class="fas fa-newspaper"></i> NEWS BRIEFING
            {% endif %}
          </p>
          <h1 class="post-title">{{ title }}</h1>
          <p class="post-meta-line">
            <span><i class="far fa-calendar"></i> {{ date | readableDate }}</span>
            {% if type == "news" and rank %}
              <span><i class="fas fa-star"></i> Top story #{{ rank }}</span>
            {% endif %}
            {% if source %}
              <span><i class="fas fa-link"></i> {{ source }}</span>
            {% endif %}
          </p>
        </header>
      {% endif %}

      <div class="content">
        {{ content | safe }}
      </div>
    </article>
  </main>

  <!-- Footer -->
  <footer>
    <div class="footer-container">
      <div class="footer-grid">
        <!-- Company Info -->
        <div class="footer-section">
          <div class="brand" style="margin-bottom: 1rem;">
            <div class="logo-circle" style="width: 40px; height: 40px;"></div>
            <div class="brand-text">
              <h1 style="font-size: 1.2rem;">{{ site.shortName }}</h1>
            </div>
          </div>
          <p style="color: var(--mm-text-muted); margin-bottom: 1rem;">
            Enterprise-grade news broadcasting with cutting-edge technology. Delivering reliable, real-time news coverage to a global audience.
          </p>
          <div class="social-links">
            <a href="https://github.com/ruslanmv" target="_blank" rel="noopener">
              <i class="fab fa-github"></i>
            </a>
            <a href="https://twitter.com/ruslanmv" target="_blank" rel="noopener">
              <i class="fab fa-twitter"></i>
            </a>
            <a href="https://linkedin.com/in/ruslanmv" target="_blank" rel="noopener">
              <i class="fab fa-linkedin-in"></i>
            </a>
          </div>
        </div>

        <!-- Quick Links -->
        <div class="footer-section">
          <h5>QUICK LINKS</h5>
          <ul>
            <li><a href="{{ '/' | url }}">Home</a></li>
            <li><a href="{{ '/' | url }}">Latest News</a></li>
            <li><a href="{{ '/archive/' | url }}">Archive</a></li>
            <li><a href="https://ruslanmv.com">About</a></li>
          </ul>
        </div>

        <!-- Resources -->
        <div class="footer-section">
          <h5>RESOURCES</h5>
          <ul>
            <li><a href="https://github.com/ruslanmv/news-and-trends" target="_blank" rel="noopener">GitHub Repository</a></li>
            <li><a href="https://ruslanmv.com" target="_blank" rel="noopener">Main Blog</a></li>
            <li><a href="https://ruslanmv.com/contact" target="_blank" rel="noopener">Contact</a></li>
          </ul>
        </div>

        <!-- Contact -->
        <div class="footer-section">
          <h5>CONTACT</h5>
          <ul>
            <li>
              <i class="fas fa-envelope" style="color: var(--mm-accent); margin-right: 0.5rem;"></i>
              <a href="mailto:contact@ruslanmv.com">contact@ruslanmv.com</a>
            </li>
            <li>
              <i class="fas fa-globe" style="color: var(--mm-accent); margin-right: 0.5rem;"></i>
              <a href="https://ruslanmv.com" target="_blank" rel="noopener">ruslanmv.com</a>
            </li>
          </ul>
        </div>
      </div>

      <div class="footer-bottom">
        <p>
          &copy; 2024 {{ site.shortName }}. All rights reserved. | Enterprise News Network
        </p>
        <p style="margin-top: 0.5rem;">
          Automated with AI agents powered by <strong>CrewAI</strong>
        </p>
      </div>
    </div>
  </footer>
</body>
</html>
