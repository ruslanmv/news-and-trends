<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>{{ title }} | {{ site.title }} · Ruslan Magana Vsevolodovna</title>
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="description" content="{{ site.subtitle }}">
  {#- Indexation governance: keep the section landing + archive indexable, but
      noindex the auto-generated daily issue pages (both `news-*` and `trend-*`)
      to avoid index bloat. They stay crawlable via `follow` so link equity still
      flows to the indexed pages. A page can opt back in with `robots: index,follow`
      in its front matter (use for heavily human-edited monthly/weekly analyses). -#}
  {%- set robotsValue = robots or ("noindex,follow" if type else "index,follow") -%}
  <meta name="robots" content="{{ robotsValue }}">
  {%- set canonicalUrl = "https://ruslanmv.com" + (page.url | url) -%}
  <link rel="canonical" href="{{ canonicalUrl }}">

  <!-- Open Graph -->
  <meta property="og:title" content="{{ title }} | News & Trends · ruslanmv.com">
  <meta property="og:description" content="{{ site.subtitle }}">
  <meta property="og:type" content="{{ "article" if type else "website" }}">
  <meta property="og:url" content="{{ canonicalUrl }}">

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css?family=Montserrat:400,500,700,800|Raleway:400,700" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">

  <style>
    /* =========================================================================
       News & Trends — a native section of ruslanmv.com
       Editorial light theme (mirrors the Essays / Blog pages) with the shared
       dark masthead and a dark-green technical hero.
       ========================================================================= */
    :root {
      /* shared dark masthead (identical to ruslanmv.com) */
      --rmv-nav-bg:#191919; --rmv-nav-ink:#fff; --rmv-accent:#06d6a0; --rmv-panel:#1f1f1f;
      /* editorial page palette */
      --nt-bg:#fafaf7; --nt-card:#ffffff; --nt-line:#e5e2dc; --nt-ink:#202622;
      --nt-muted:#69716c; --nt-faint:#98a09a;
      --nt-accent:#0a7d4f; --nt-accent-deep:#0b5a3f; --nt-accent-bright:#00c896;
      --nt-serif:Georgia,"Times New Roman",serif;
    }

    * { box-sizing:border-box; margin:0; padding:0; }
    html { background:var(--nt-bg); -webkit-text-size-adjust:100%; }
    body {
      font-family:'Raleway',system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;
      background:var(--nt-bg); color:var(--nt-ink); line-height:1.6;
      min-height:100vh; display:flex; flex-direction:column;
      -webkit-font-smoothing:antialiased;
    }
    a { color:var(--nt-accent); text-decoration:none; transition:color .15s ease; }
    a:hover { color:var(--nt-accent-deep); }
    img { max-width:100%; }

    /* =========================================================================
       Masthead navigation — ported verbatim from ruslanmv.com
       ========================================================================= */
    .masthead { background:var(--rmv-nav-bg); border-bottom:1px solid #000; position:relative; z-index:60; }
    .masthead__inner-wrap { padding:0 1.25rem; max-width:1200px; margin:0 auto; box-sizing:border-box; width:100%; }
    .rmv-nav { display:flex; align-items:center; gap:1rem; min-height:60px; max-width:100%; box-sizing:border-box; }
    .rmv-nav__brand {
      font-family:'Montserrat',sans-serif; font-weight:700; font-size:1.15rem;
      color:var(--rmv-nav-ink); text-decoration:none; white-space:nowrap; margin-right:auto;
    }
    .rmv-nav__brand:hover { color:var(--rmv-accent); }
    .rmv-nav__links { display:flex; align-items:center; gap:0.25rem; list-style:none; margin:0; padding:0; }
    .rmv-nav__item { position:relative; display:flex; align-items:center; }
    .rmv-nav__toplink {
      display:inline-flex; align-items:center; gap:0.25rem; color:var(--rmv-nav-ink);
      text-decoration:none; font-size:0.98rem; font-weight:500; padding:0.5rem 0.8rem; border-radius:8px;
      white-space:nowrap;
    }
    .rmv-nav__toplink:visited { color:var(--rmv-nav-ink); }
    .rmv-nav__toplink:hover, .rmv-nav__toplink:visited:hover,
    .rmv-nav__item--has-children:hover .rmv-nav__toplink,
    .rmv-nav__item.is-open .rmv-nav__toplink { color:var(--rmv-accent); }
    .rmv-nav__toplink:focus-visible { outline:2px solid var(--rmv-accent); outline-offset:3px; color:var(--rmv-accent); }
    .rmv-nav__item.is-active > .rmv-nav__toplink,
    .rmv-nav__item.is-active > .rmv-nav__toplink:visited { color:var(--rmv-accent); }
    .rmv-nav__item.is-active > .rmv-nav__toplink::after {
      content:""; position:absolute; left:0.8rem; right:0.8rem; bottom:2px; height:2px;
      background:var(--rmv-accent); border-radius:2px;
    }
    .rmv-caret { font-size:0.7em; opacity:0.7; transition:transform 0.15s ease; }
    .rmv-nav__item.is-open .rmv-caret { transform:rotate(180deg); }
    .rmv-submenu {
      position:absolute; top:100%; left:0; margin:0; padding:0.4rem 0; min-width:13.5rem;
      list-style:none; background:var(--rmv-panel); border:1px solid #2c2c2c; border-radius:10px;
      box-shadow:0 12px 30px rgba(0,0,0,0.35);
      opacity:0; visibility:hidden; transform:translateY(6px);
      transition:opacity 0.15s ease, transform 0.15s ease, visibility 0.15s ease; z-index:70;
    }
    .rmv-nav__item--has-children:hover > .rmv-submenu,
    .rmv-nav__item.is-open > .rmv-submenu { opacity:1; visibility:visible; transform:translateY(0); }
    .rmv-submenu li { margin:0; }
    .rmv-submenu a { display:block; padding:0.6rem 1.1rem; color:#d6d6d6; text-decoration:none; font-size:0.92rem; white-space:nowrap; }
    .rmv-submenu a:visited { color:#d6d6d6; }
    .rmv-submenu a:hover { background:#2a2a2a; color:var(--rmv-accent); }
    .rmv-nav__actions { display:flex; align-items:center; gap:0.4rem; margin-left:0.5rem; }
    .rmv-nav__search, .rmv-burger {
      background:transparent; border:0; color:var(--rmv-nav-ink); cursor:pointer;
      width:42px; height:42px; display:inline-flex; align-items:center; justify-content:center;
      border-radius:10px; padding:0; transition:background-color .18s ease, color .18s ease;
      -webkit-tap-highlight-color:transparent;
    }
    .rmv-nav__search:hover { color:var(--rmv-accent); background:rgba(255,255,255,0.08); }
    .rmv-burger:hover { background:rgba(255,255,255,0.08); }
    .rmv-burger:focus-visible, .rmv-nav__search:focus-visible { outline:2px solid var(--rmv-accent); outline-offset:2px; }
    .rmv-burger__bars { position:relative; width:22px; height:16px; display:block; }
    .rmv-burger__bar {
      position:absolute; left:0; width:22px; height:2px; border-radius:2px;
      background:currentColor; color:var(--rmv-nav-ink);
      transition:transform .25s cubic-bezier(.4,.01,.25,1), opacity .2s ease, width .25s ease, background-color .18s ease;
    }
    .rmv-burger__bar:nth-child(1) { top:0; }
    .rmv-burger__bar:nth-child(2) { top:7px; width:16px; }
    .rmv-burger__bar:nth-child(3) { top:14px; }
    .rmv-burger:hover .rmv-burger__bar { background:var(--rmv-accent); }
    .rmv-burger:hover .rmv-burger__bar:nth-child(2) { width:22px; }
    body.rmv-drawer-open .rmv-burger__bar:nth-child(1) { transform:translateY(7px) rotate(45deg); }
    body.rmv-drawer-open .rmv-burger__bar:nth-child(2) { opacity:0; transform:scaleX(0); }
    body.rmv-drawer-open .rmv-burger__bar:nth-child(3) { transform:translateY(-7px) rotate(-45deg); }
    body.rmv-drawer-open .rmv-burger__bar { width:22px; }
    .rmv-drawer-overlay { position:fixed; inset:0; background:rgba(0,0,0,0.5); z-index:90; opacity:0; transition:opacity 0.2s ease; }
    .rmv-drawer-overlay.is-open { opacity:1; }
    .rmv-drawer {
      position:fixed; top:0; right:0; height:100%; width:min(88vw, 340px);
      background:var(--rmv-nav-bg); color:var(--rmv-nav-ink); z-index:100;
      transform:translateX(100%); transition:transform 0.25s ease; display:flex; flex-direction:column;
      box-shadow:-12px 0 30px rgba(0,0,0,0.35);
    }
    .rmv-drawer.is-open { transform:translateX(0); }
    .rmv-drawer__head { display:flex; align-items:center; justify-content:space-between; padding:1rem 1.25rem; border-bottom:1px solid #2c2c2c; }
    .rmv-drawer__brand { font-family:'Montserrat',sans-serif; font-weight:700; font-size:1rem; }
    .rmv-drawer__close { background:transparent; border:0; color:var(--rmv-nav-ink); font-size:1.9rem; line-height:1; cursor:pointer; width:44px; height:44px; }
    .rmv-drawer__close:hover { color:var(--rmv-accent); }
    .rmv-drawer__nav { flex:1; overflow-y:auto; padding:0.5rem 0; }
    .rmv-drawer__nav ul { list-style:none; margin:0; padding:0; }
    .rmv-drawer__nav a { display:flex; align-items:center; min-height:48px; padding:0.4rem 1.5rem; color:var(--rmv-nav-ink); text-decoration:none; font-size:1.05rem; }
    .rmv-drawer__nav a:visited { color:var(--rmv-nav-ink); }
    .rmv-drawer__nav a:hover { background:#262626; color:var(--rmv-accent); }
    .rmv-drawer__nav a.is-active, .rmv-drawer__nav a.is-active:visited { color:var(--rmv-accent); background:#1f2b25; }
    .rmv-drawer__nav li.is-indent a { padding-left:2.5rem; font-size:0.97rem; color:#bdbdbd; }
    .rmv-drawer__social { display:flex; gap:0.5rem; padding:1rem 1.25rem; border-top:1px solid #2c2c2c; }
    .rmv-drawer__social a { width:44px; height:44px; display:flex; align-items:center; justify-content:center; color:var(--rmv-nav-ink); font-size:1.2rem; border-radius:8px; }
    .rmv-drawer__social a:hover { color:var(--rmv-accent); background:rgba(255,255,255,0.06); }
    @media (max-width: 820px) {
      .rmv-nav__links { display:none; }
      .rmv-nav { min-height:56px; gap:0.5rem; }
      .rmv-nav__brand { font-size:1rem; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; min-width:0; }
      .rmv-nav__actions { margin-left:0; flex:0 0 auto; }
      .masthead__inner-wrap { padding:0 0.75rem; }
    }

    /* =========================================================================
       Hero — dark-green technical band (mirrors the Essays hero)
       ========================================================================= */
    .nt-hero { position:relative; background:#08120d; overflow:hidden; }
    .nt-hero__bg { position:absolute; inset:0; width:100%; height:100%; }
    .nt-hero__inner { position:relative; z-index:1; max-width:1180px; margin:0 auto; padding:3.4rem 1.5rem; }
    .nt-hero--compact .nt-hero__inner { padding:2.3rem 1.5rem; }
    .nt-hero__eyebrow {
      display:inline-flex; align-items:center; gap:0.5rem; color:#7dffd0; font-size:0.78rem;
      font-weight:700; letter-spacing:0.14em; text-transform:uppercase; margin:0 0 0.85rem;
    }
    .nt-hero__title { font-family:'Montserrat',sans-serif; font-weight:800; color:#fff; font-size:clamp(40px,6.5vw,72px); line-height:1; margin:0; letter-spacing:-0.01em; }
    .nt-hero__sub { color:#cfe9dc; font-size:clamp(15px,2vw,18px); line-height:1.5; margin:1rem 0 0; max-width:40rem; }
    .nt-hero__chips { display:flex; flex-wrap:wrap; gap:0.5rem; margin:1.4rem 0 0; }
    .nt-hero__chip { font-size:0.78rem; color:#bfe9d6; border:1px solid rgba(125,255,208,0.28); background:rgba(13,42,30,0.5); padding:0.3rem 0.7rem; border-radius:999px; }

    /* =========================================================================
       Layout shell — author sidebar + content (mirrors Essays)
       ========================================================================= */
    .nt { max-width:1180px; margin:0 auto; padding:2.5rem 1.5rem 4.5rem; display:grid; grid-template-columns:1fr; gap:2.5rem; }
    @media (min-width:920px) { .nt { grid-template-columns:240px minmax(0,1fr); gap:3rem; } }

    .nt-author { text-align:left; }
    @media (min-width:920px) { .nt-author { position:sticky; top:1.5rem; align-self:start; } }
    .nt-author__photo { width:120px; height:120px; border-radius:50%; object-fit:cover; border:1px solid var(--nt-line); }
    .nt-author__name { font-family:var(--nt-serif); font-size:1.5rem; color:var(--nt-ink); margin:1rem 0 0.4rem; line-height:1.15; }
    .nt-author__role { color:var(--nt-muted); font-size:0.95rem; line-height:1.45; margin:0 0 1rem; }
    .nt-author__links { list-style:none; margin:0; padding:0; }
    .nt-author__links li { margin:0 0 0.1rem; }
    .nt-author__links a { display:flex; align-items:center; gap:0.6rem; min-height:40px; color:var(--nt-ink); text-decoration:none; font-size:0.95rem; }
    .nt-author__links a:hover { color:var(--nt-accent); }
    .nt-author__links .ic { width:18px; text-align:center; color:var(--nt-faint); }
    .nt-author__links a:hover .ic { color:var(--nt-accent); }
    .nt-author__label { margin-top:1.4rem; padding-top:1.1rem; border-top:1px solid var(--nt-line); font-size:0.78rem; color:var(--nt-faint); line-height:1.5; }
    .nt-author__label strong { color:var(--nt-muted); font-weight:600; }

    .nt-main { min-width:0; }

    /* ---- section tabs (Today | Archive | GitHub) ---- */
    .nt-tabs { display:flex; gap:1.6rem; border-bottom:1px solid var(--nt-line); margin:0 0 1.9rem; overflow-x:auto; -webkit-overflow-scrolling:touch; }
    .nt-tab { background:none; border:0; cursor:pointer; padding:0 0 0.9rem; display:inline-flex; align-items:center; gap:0.4rem; white-space:nowrap; position:relative; color:var(--nt-muted); font-size:1.02rem; font-weight:600; text-decoration:none; font-family:'Raleway',sans-serif; }
    .nt-tab:hover { color:var(--nt-ink); }
    .nt-tab.is-active { color:var(--nt-ink); }
    .nt-tab.is-active:after { content:""; position:absolute; left:0; right:0; bottom:-1px; height:2px; background:var(--nt-accent); }
    .nt-tab .fa-arrow-up-right-from-square { font-size:0.72em; opacity:0.6; }

    /* ---- back link (article pages) ---- */
    .nt-back { display:inline-flex; align-items:center; gap:0.4rem; color:var(--nt-muted); font-size:0.9rem; font-weight:600; margin:0 0 1.6rem; }
    .nt-back:hover { color:var(--nt-accent); }

    /* =========================================================================
       Editorial content primitives (shared by index / archive / articles)
       ========================================================================= */
    .nt-kicker { font-size:0.74rem; font-weight:700; letter-spacing:0.12em; text-transform:uppercase; color:var(--nt-accent); margin:0 0 0.6rem; }
    .nt-section-head { display:flex; align-items:baseline; justify-content:space-between; gap:1rem; margin:2.4rem 0 1.1rem; }
    .nt-section-head.is-first { margin-top:0; }
    .nt-section-head h2 { font-family:var(--nt-serif); font-size:1.35rem; color:var(--nt-ink); margin:0; font-weight:700; }
    .nt-section-head a { font-size:0.88rem; font-weight:600; white-space:nowrap; }

    /* digest summary header */
    .nt-digest { background:var(--nt-card); border:1px solid var(--nt-line); border-radius:16px; padding:1.5rem 1.6rem; }
    .nt-digest__date { font-family:var(--nt-serif); font-size:1.6rem; color:var(--nt-ink); margin:0.2rem 0 0.5rem; }
    .nt-digest__meta { display:flex; flex-wrap:wrap; gap:0.5rem; margin:0 0 0.6rem; }
    .nt-pill { font-size:0.8rem; color:var(--nt-muted); background:var(--nt-bg); border:1px solid var(--nt-line); padding:0.25rem 0.7rem; border-radius:999px; display:inline-flex; align-items:center; gap:0.35rem; }
    .nt-digest__note { color:var(--nt-muted); font-size:0.96rem; margin:0; }

    /* featured trend card */
    .nt-trend { display:block; background:var(--nt-card); border:1px solid var(--nt-line); border-radius:16px; padding:1.7rem 1.8rem; box-shadow:0 10px 26px rgba(10,80,50,0.05); transition:border-color .15s, box-shadow .15s, transform .15s; color:inherit; }
    .nt-trend:hover { border-color:var(--nt-accent); box-shadow:0 16px 34px rgba(10,80,50,0.09); transform:translateY(-1px); color:inherit; }
    .nt-trend__title { font-family:var(--nt-serif); font-size:1.55rem; line-height:1.22; color:var(--nt-ink); margin:0.5rem 0 0.7rem; }
    .nt-trend__summary { color:var(--nt-muted); font-size:1rem; line-height:1.6; margin:0 0 1.2rem; }
    .nt-cta { display:inline-flex; align-items:center; gap:0.45rem; color:var(--nt-accent); font-weight:700; font-size:0.95rem; }
    .nt-trend:hover .nt-cta { color:var(--nt-accent-deep); }

    /* news cards (stacked, numbered) */
    .nt-news { display:flex; flex-direction:column; gap:1rem; }
    .nt-newscard { display:grid; grid-template-columns:auto 1fr; gap:1.1rem; align-items:start; background:var(--nt-card); border:1px solid var(--nt-line); border-radius:14px; padding:1.3rem 1.4rem; transition:border-color .15s, box-shadow .15s, transform .15s; color:inherit; }
    .nt-newscard:hover { border-color:var(--nt-accent); box-shadow:0 12px 26px rgba(10,80,50,0.06); transform:translateY(-1px); color:inherit; }
    .nt-newscard__num { font-family:var(--nt-serif); font-size:1.15rem; font-weight:700; color:var(--nt-accent); background:var(--nt-bg); border:1px solid var(--nt-line); width:2.4rem; height:2.4rem; border-radius:10px; display:flex; align-items:center; justify-content:center; }
    .nt-newscard__source { font-size:0.76rem; font-weight:700; letter-spacing:0.04em; text-transform:uppercase; color:var(--nt-accent-deep); margin:0 0 0.3rem; }
    .nt-newscard__title { font-family:var(--nt-serif); font-size:1.18rem; line-height:1.3; color:var(--nt-ink); margin:0 0 0.4rem; }
    .nt-newscard__summary { color:var(--nt-muted); font-size:0.94rem; line-height:1.55; margin:0 0 0.6rem; }
    .nt-newscard__more { font-size:0.86rem; font-weight:600; }

    /* archive teaser */
    .nt-teaser { margin-top:2.4rem; display:flex; flex-wrap:wrap; align-items:center; justify-content:space-between; gap:1rem; background:linear-gradient(135deg,#0f231a,#0a1a13); border-radius:16px; padding:1.5rem 1.7rem; }
    .nt-teaser p { margin:0; color:#cfe9dc; font-size:0.98rem; }
    .nt-teaser strong { color:#fff; }
    .nt-teaser a { display:inline-flex; align-items:center; gap:0.45rem; background:var(--nt-accent-bright); color:#06281c; font-weight:700; font-size:0.92rem; padding:0.6rem 1.1rem; border-radius:10px; }
    .nt-teaser a:hover { background:#7dffd0; color:#06281c; }

    /* archive list cards */
    .nt-arch { display:flex; flex-direction:column; gap:0.9rem; }
    .nt-archcard { display:block; background:var(--nt-card); border:1px solid var(--nt-line); border-radius:13px; padding:1.1rem 1.3rem; transition:border-color .15s, box-shadow .15s, transform .15s; color:inherit; }
    .nt-archcard:hover { border-color:var(--nt-accent); box-shadow:0 10px 22px rgba(10,80,50,0.06); transform:translateY(-1px); color:inherit; }
    .nt-archcard__head { display:flex; flex-wrap:wrap; align-items:center; gap:0.5rem; margin:0 0 0.5rem; }
    .nt-badge { font-size:0.7rem; font-weight:700; letter-spacing:0.05em; text-transform:uppercase; padding:0.2rem 0.55rem; border-radius:999px; }
    .nt-badge--trend { background:rgba(10,125,79,0.12); color:var(--nt-accent-deep); }
    .nt-badge--news { background:rgba(0,122,90,0.10); color:var(--nt-accent); }
    .nt-archcard__date { font-size:0.78rem; color:var(--nt-faint); }
    .nt-archcard__title { font-family:var(--nt-serif); font-size:1.12rem; line-height:1.3; color:var(--nt-ink); margin:0 0 0.4rem; }
    .nt-archcard__summary { color:var(--nt-muted); font-size:0.9rem; line-height:1.5; margin:0; }

    /* =========================================================================
       Article body (news / trend individual pages)
       ========================================================================= */
    .nt-article { background:var(--nt-card); border:1px solid var(--nt-line); border-radius:18px; padding:2.2rem 2.2rem 2.4rem; box-shadow:0 12px 30px rgba(10,80,50,0.05); }
    .nt-article__kicker { font-size:0.76rem; text-transform:uppercase; letter-spacing:0.12em; color:var(--nt-accent); margin-bottom:0.6rem; font-weight:700; }
    .nt-article__title { font-family:var(--nt-serif); font-size:clamp(1.7rem,3.4vw,2.3rem); margin:0 0 0.7rem; line-height:1.18; color:var(--nt-ink); }
    .nt-article__meta { font-size:0.9rem; color:var(--nt-muted); display:flex; flex-wrap:wrap; gap:0.5rem; align-items:center; }
    .nt-article__meta span + span::before { content:"•"; margin-right:0.5rem; color:var(--nt-faint); }
    .nt-article__divider { margin:1.3rem 0 1.6rem; border:none; border-top:1px solid var(--nt-line); }

    .nt-prose { color:#2b322d; font-size:1.04rem; line-height:1.75; }
    .nt-prose > *:first-child { margin-top:0; }
    .nt-prose h2 { font-family:var(--nt-serif); font-size:1.4rem; color:var(--nt-ink); margin:2rem 0 0.7rem; }
    .nt-prose h3 { font-family:var(--nt-serif); font-size:1.18rem; color:var(--nt-ink); margin:1.6rem 0 0.6rem; }
    .nt-prose p { margin:0 0 1.1rem; }
    .nt-prose ul, .nt-prose ol { margin:0 0 1.1rem 1.3rem; }
    .nt-prose li { margin:0 0 0.4rem; }
    .nt-prose a { color:var(--nt-accent); text-decoration:underline; text-underline-offset:2px; }
    .nt-prose a:hover { color:var(--nt-accent-deep); }
    .nt-prose hr { border:none; border-top:1px solid var(--nt-line); margin:1.6rem 0; }
