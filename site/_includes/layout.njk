<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>{{ title }} | {{ site.title }}</title>
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <style>
    :root {
      --bg: #f7f7fb;
      --fg: #1f2933;
      --accent: #2563eb;
    }
    body {
      font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      margin: 0;
      background: var(--bg);
      color: var(--fg);
    }
    header {
      background: white;
      border-bottom: 1px solid #e5e7eb;
      padding: 1.5rem 1rem;
    }
    header .container {
      max-width: 960px;
      margin: 0 auto;
      display: flex;
      flex-direction: column;
      gap: 0.25rem;
    }
    header h1 {
      margin: 0;
      font-size: 1.5rem;
    }
    header a {
      color: var(--accent);
      text-decoration: none;
    }
    nav a {
      margin-right: 1rem;
      font-size: 0.95rem;
    }
    main {
      max-width: 960px;
      margin: 1.5rem auto;
      padding: 0 1rem 2rem;
      background: white;
      border-radius: 0.75rem;
      box-shadow: 0 10px 30px rgba(15, 23, 42, 0.06);
    }
    main h1, main h2, main h3 {
      color: #111827;
    }
    main h1 {
      margin-top: 0;
      padding-top: 1.5rem;
    }
    main > *:first-child {
      margin-top: 0;
    }
    footer {
      max-width: 960px;
      margin: 0 auto 2rem;
      padding: 0 1rem;
      font-size: 0.85rem;
      color: #6b7280;
    }
    a {
      color: var(--accent);
    }
    .archive-list li {
      margin-bottom: 0.35rem;
    }
  </style>
</head>
<body>
  <header>
    <div class="container">
      <h1><a href="/">{{ site.title }}</a></h1>
      <p>{{ site.subtitle }}</p>
      <nav>
        <a href="/">This week</a>
        <a href="/archive/">Archive</a>
        <a href="https://github.com/">GitHub</a>
      </nav>
    </div>
  </header>
  <main>
    {{ content | safe }}
  </main>
  <footer>
    <hr>
    <p>Generated automatically each week by GitHub Actions, CrewAI, and your choice of LLM (Ollama, Watsonx, OpenAI, Claude).</p>
  </footer>
</body>
</html>
